# =============================================================================
# Dev harness (backend/) — local FastAPI + HTML UI used to develop and test
# =============================================================================

# --- LLM provider keys ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Models ---
WHISPER_MODEL=whisper-1
STRUCTURING_MODEL=gpt-4o-2024-11-20
DIAGNOSIS_MODEL=claude-opus-4-7

# --- FHIR backend (dev harness) ---
# When FHIR_MODE=local, the harness reads/writes data/patients_store.json
# (seeded from sample-patient.json on first run) AND exposes a FHIR-shaped
# passthrough at /fhir/* so the MCP server and A2A agent can hit it during
# local development.
FHIR_MODE=local
FHIR_BASE_URL=http://localhost:8080/fhir

# --- Server (dev harness) ---
APP_HOST=127.0.0.1
APP_PORT=8000


# =============================================================================
# MCP server (mcp_app/) — publishable to the Prompt Opinion Marketplace
# =============================================================================

# Bind address for the MCP HTTP server.
MCP_HOST=0.0.0.0
MCP_PORT=8010

# In production, no FHIR URL or token is hardcoded — Prompt Opinion injects
# them as headers per request:  x-fhir-server-url, x-fhir-access-token, x-patient-id.


# =============================================================================
# A2A agent (a2a_app/) — publishable to the Prompt Opinion Marketplace
# =============================================================================

# Public URL where the agent is reachable. Goes into the agent card's
# `supportedInterfaces`. Use http://localhost:8020 for local dev.
CLINICAL_SCRIBE_AGENT_URL=http://localhost:8020
CLINICAL_SCRIBE_AGENT_PORT=8020

# Your Prompt Opinion workspace base URL — used to construct the
# fhir-context extension URI in the agent card.
PO_PLATFORM_BASE_URL=https://your-workspace.promptopinion.ai

# X-API-Key values that may call the agent. Either a comma-separated list…
API_KEYS=
# …or named slots:
API_KEY_PRIMARY=
API_KEY_SECONDARY=

# Model — LiteLLM provider-prefixed format, e.g.
#   gemini/gemini-2.5-flash
#   openai/gpt-4o
#   anthropic/claude-sonnet-4-6
CLINICAL_SCRIBE_AGENT_MODEL=gemini/gemini-2.5-flash
GOOGLE_API_KEY=
