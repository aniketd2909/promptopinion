# ── LLM API keys ──────────────────────────────────────────────────────────────

# Required by StructureClinicalConversation (GPT-4o structured output)
OPENAI_API_KEY=

# Required by SuggestDiagnosis (Claude Opus 4.7)
ANTHROPIC_API_KEY=

# Required by the A2A agent runtime (default model: gemini/gemini-2.5-flash)
GOOGLE_API_KEY=

# ── MCP server (mcp_app) ──────────────────────────────────────────────────────

# Override the model used for transcript structuring (default: gpt-4o-2024-11-20)
# STRUCTURING_MODEL=gpt-4o-2024-11-20

# Override the model used for diagnosis suggestions (default: claude-opus-4-7)
# DIAGNOSIS_MODEL=claude-opus-4-7

# Host/port the MCP server listens on (defaults: 0.0.0.0 / 8010)
# MCP_HOST=0.0.0.0
# MCP_PORT=8010

# ── A2A agent (a2a_app) ───────────────────────────────────────────────────────

# API key(s) the platform sends as X-Api-Key to authenticate calls to the agent.
# Use API_KEY_PRIMARY / API_KEY_SECONDARY, or a comma-separated API_KEYS list.
API_KEY_PRIMARY=

# Public URL of this agent — written into the agent card's supportedInterfaces.
# Set this when deploying; for local dev the default (http://localhost:8020) is fine.
# CLINICAL_SCRIBE_AGENT_URL=https://your-host.example.com

# Prompt Opinion platform base URL (used to build the fhir-context extension URI)
# PO_PLATFORM_BASE_URL=https://your-workspace.promptopinion.ai

# Override the A2A agent LLM (default: gemini/gemini-2.5-flash via LiteLLM)
# CLINICAL_SCRIBE_AGENT_MODEL=gemini/gemini-2.5-flash

# ── Debug / logging ───────────────────────────────────────────────────────────

# Set to "true" to log full A2A request/response payloads (default: true)
# LOG_FULL_PAYLOAD=true

# Set to "true" to log raw ADK hook objects (default: false)
# LOG_HOOK_RAW_OBJECTS=false
