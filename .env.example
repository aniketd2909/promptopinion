# ── LLM API keys ──────────────────────────────────────────────────────────────

# Required for transcript structuring + diagnosis suggestion.
# Get it from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── FHIR backend ──────────────────────────────────────────────────────────────

# Public HAPI test server is the default — open, no auth, R4 compliant.
# Override with your own HAPI / Medplum / commercial FHIR R4 base URL.
# In production, the Prompt Opinion platform injects this via the
# `x-fhir-server-url` header and the env var is ignored.
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# Bearer token for the FHIR server. Leave blank for HAPI public.
# In production, the platform injects this via `x-fhir-access-token`.
# FHIR_ACCESS_TOKEN=

# ── MCP server (mcp_app) ──────────────────────────────────────────────────────

# Override the model used for transcript structuring (default: gemini-3.1-flash-lite)
# STRUCTURING_MODEL=gemini-3.1-flash-lite

# Override the model used for diagnosis suggestions (default: gemini/gemini-3.1-flash-lite)
# DIAGNOSIS_MODEL=gemini/gemini-3.1-flash-lite

# Host/port the MCP server listens on (defaults: 0.0.0.0 / 8010)
# MCP_HOST=0.0.0.0
# MCP_PORT=8010
